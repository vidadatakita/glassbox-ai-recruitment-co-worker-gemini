#!/usr/bin/env bash
# Google Cloud: Cloud Run + Cloud SQL (PostgreSQL 16) + Cloud Storage + Secret Manager.
#
#   bin/gcp setup    one time: APIs, service account, database, bucket, secrets
#   bin/gcp deploy   build the Dockerfile with Cloud Build and deploy it to Cloud Run
#
# Needs: gcloud logged in (`gcloud auth login`) and a project with billing enabled.
# Override any variable below from the shell, e.g. `PROJECT=my-proj REGION=us-central1 bin/gcp setup`.
set -euo pipefail

PROJECT="${PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
REGION="${REGION:-asia-southeast2}" # Jakarta (UU PDP, see GoogleIntegration::Config)
SERVICE="${SERVICE:-glassbox}"
SQL_INSTANCE="${SQL_INSTANCE:-glassbox-db}"
SQL_TIER="${SQL_TIER:-db-f1-micro}" # cheapest; enough for a prototype
BUCKET="${BUCKET:-$PROJECT-glassbox-files}"
TENANCY="${TENANCY:-single}"
# The Cup deployment is the demo: the no-login door and the nightly reset are on. Set DEMO_MODE=0 for a real install.
DEMO_MODE="${DEMO_MODE:-1}"
# FLOW §9 model tiers; override from the shell with the ids confirmed in the project (glassbox:ai:smoke TIER=...).
AI_MODEL_HIGH="${AI_MODEL_HIGH:-gemini-3.8-pro}"
AI_MODEL_MEDIUM="${AI_MODEL_MEDIUM:-gemini-3.8-flash}"
AI_MODEL_LOW="${AI_MODEL_LOW:-gemini-3.5-flash-lite}"
SA="$SERVICE-run@$PROJECT.iam.gserviceaccount.com"
SQL_CONN="$PROJECT:$REGION:$SQL_INSTANCE"

[ -n "$PROJECT" ] || { echo "Set PROJECT or run: gcloud config set project <id>"; exit 1; }
gcloud config set project "$PROJECT" >/dev/null

# Secrets are created once; re-running setup never rotates them (that would lock the app out).
has_secret() { gcloud secrets describe "$1" >/dev/null 2>&1; }
secret() { gcloud secrets create "$1" --data-file=-; } # value on stdin

setup() {
  gcloud services enable run.googleapis.com cloudbuild.googleapis.com artifactregistry.googleapis.com \
    sqladmin.googleapis.com secretmanager.googleapis.com storage.googleapis.com aiplatform.googleapis.com

  # One service account runs the app and holds the storage key.
  gcloud iam service-accounts create "$SERVICE-run" --display-name "GlassBox Cloud Run" || true
  for role in roles/cloudsql.client roles/aiplatform.user; do
    gcloud projects add-iam-policy-binding "$PROJECT" --member "serviceAccount:$SA" --role "$role" --condition None >/dev/null
  done

  # Database: production.rb connects as "glassbox" to four databases (primary, cache, queue, cable).
  gcloud sql instances create "$SQL_INSTANCE" --database-version POSTGRES_16 --edition ENTERPRISE \
    --tier "$SQL_TIER" --region "$REGION" || true
  for db in glassbox_production glassbox_production_cache glassbox_production_queue glassbox_production_cable; do
    gcloud sql databases create "$db" --instance "$SQL_INSTANCE" || true
  done
  if ! has_secret glassbox-db-password; then
    db_password="$(openssl rand -hex 24)"
    gcloud sql users create glassbox --instance "$SQL_INSTANCE" --password "$db_password" 2>/dev/null ||
      gcloud sql users set-password glassbox --instance "$SQL_INSTANCE" --password "$db_password"
    printf %s "$db_password" | secret glassbox-db-password
  fi

  # Files (CVs, recordings): private bucket, no public access.
  gcloud storage buckets create "gs://$BUCKET" --location "$REGION" --uniform-bucket-level-access \
    --public-access-prevention || true
  gcloud storage buckets add-iam-policy-binding "gs://$BUCKET" --member "serviceAccount:$SA" \
    --role roles/storage.objectAdmin >/dev/null

  # ponytail: storage reads a JSON key (GoogleIntegration::Config); switch to the Cloud Run
  # service account's own identity (no key) if the org policy blocks key creation.
  has_secret glassbox-google-sa-json ||
    gcloud iam service-accounts keys create /dev/stdout --iam-account "$SA" 2>/dev/null | tr -d '\n' |
      secret glassbox-google-sa-json

  # No config/master.key in the repo, so the app signs cookies with SECRET_KEY_BASE instead.
  has_secret glassbox-secret-key-base || openssl rand -hex 64 | tr -d '\n' | secret glassbox-secret-key-base

  # Read access to these three secrets only, not every secret in the project.
  for s in glassbox-db-password glassbox-secret-key-base glassbox-google-sa-json; do
    gcloud secrets add-iam-policy-binding "$s" --member "serviceAccount:$SA" \
      --role roles/secretmanager.secretAccessor >/dev/null
  done

  echo "Setup done. Next: bin/gcp deploy"
}

deploy() {
  # ponytail: one instance, CPU always on. Solid Queue runs inside Puma (AI screening jobs need CPU
  # between requests) and db:prepare runs at boot (two instances would race). Split the worker
  # into its own service and migrate with a Cloud Run job when one instance is not enough.
  # HTTP_WRITE_TIMEOUT: Thruster cuts any response not written within 30 s by default, and the
  # on-demand AI screens (brief draft, discrimination test, test-scoring advice, fairness check)
  # wait on a Gemini call that can take longer on the HIGH tier. 300 s matches Cloud Run's request
  # timeout (--timeout 300).
  gcloud run deploy "$SERVICE" --source . --region "$REGION" --service-account "$SA" \
    --add-cloudsql-instances "$SQL_CONN" \
    --port 8080 --min-instances 1 --max-instances 1 --no-cpu-throttling --memory 1Gi --timeout 300 \
    --allow-unauthenticated \
    --set-env-vars "HTTP_PORT=8080,HTTP_WRITE_TIMEOUT=300,TENANCY=$TENANCY,DEMO_MODE=${DEMO_MODE:-1},AI_PROVIDER=gemini,AI_MODEL_HIGH=${AI_MODEL_HIGH:-gemini-3.8-pro},AI_MODEL_MEDIUM=${AI_MODEL_MEDIUM:-gemini-3.8-flash},AI_MODEL_LOW=${AI_MODEL_LOW:-gemini-3.5-flash-lite},DATABASE_HOST=/cloudsql/$SQL_CONN,SOLID_QUEUE_IN_PUMA=true,GLASSBOX_STORAGE_SERVICE=google,GOOGLE_STORAGE_BUCKET=$BUCKET,GOOGLE_STORAGE_REGION=$REGION" \
    --set-secrets "GLASSBOX_DATABASE_PASSWORD=glassbox-db-password:latest,SECRET_KEY_BASE=glassbox-secret-key-base:latest,GOOGLE_SERVICE_ACCOUNT_JSON=glassbox-google-sa-json:latest"

  url="$(gcloud run services describe "$SERVICE" --region "$REGION" --format 'value(status.url)')"
  # Links inside emails use APP_HOST.
  gcloud run services update "$SERVICE" --region "$REGION" --update-env-vars "APP_HOST=${url#https://}" >/dev/null
  echo "Live: $url"
}

case "${1:-}" in
  setup) setup ;;
  deploy) deploy ;;
  *) echo "Usage: bin/gcp setup|deploy"; exit 1 ;;
esac
