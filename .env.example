# Copy to .env and fill in. .env is never committed or baked into the image.
# Every app setting is declared in lib/glassbox/settings.rb.

# --- Mode -------------------------------------------------------------------
# Development: keep this line. Production: delete it.
COMPOSE_FILE=compose.yml:compose.dev.yml

# Host port the app is published on.
APP_PORT=3000

# --- App --------------------------------------------------------------------
# Required: single = one client company per install, multi = subscription.
TENANCY=single
# 1 = the public demo: the no-login door at /demo and the nightly reset (03:00 WIB) are on. Never 1 on a real install.
DEMO_MODE=0
# off = skip the scheduled nightly reset (claims check, video recording); the rake task still runs on demand.
DEMO_RESET=on

# --- AI screening -----------------------------------------------------------
# Provider: gemini is the only value (Google products only).
AI_PROVIDER=gemini
# Gemini API key (AI Studio). Leave empty to use Vertex AI with GOOGLE_SERVICE_ACCOUNT_JSON.
AI_API_KEY=
# gemini (default) = AI_API_KEY is an AI Studio key; vertex = a Vertex AI express-mode key (Google Cloud console).
AI_API_KEY_ENDPOINT=
# Vertex AI project of an express-mode key (id or number); empty = Google picks the location.
GOOGLE_CLOUD_PROJECT=
# One model and thinking level for every tier at once (rarely wanted). Empty = each tier's default.
AI_MODEL=
AI_THINKING=
# Model tiers (FLOW §9): HIGH = judgements a person acts on (CV scoring, test scoring, stage advice,
# fairness); MEDIUM = structured drafting (brief, discrimination test); LOW = short text (ad, letters, chat).
# Empty = the defaults below. An id not in Screening::Config::KNOWN_MODELS stops the server at boot.
AI_MODEL_HIGH=      # default gemini-3.8-flash
AI_MODEL_MEDIUM=    # default gemini-3.8-flash
AI_MODEL_LOW=       # default gemini-3.5-flash-lite
AI_THINKING_HIGH=   # default medium
AI_THINKING_MEDIUM= # default medium
AI_THINKING_LOW=    # default low

# --- Database ---------------------------------------------------------------
# host.docker.internal = PostgreSQL on the Docker host itself; otherwise its IP/hostname.
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
# Development reads the password from ~/.pgpass (user: postgres).
# Production connects as user "glassbox" to glassbox_production, _cache, _queue and _cable.
GLASSBOX_DATABASE_PASSWORD=

# --- Production only: uncomment ---------------------------------------------
# Decrypts config/credentials.yml.enc (value of config/master.key).
# RAILS_MASTER_KEY=
# Run Solid Queue jobs inside Puma (one container). Any value turns it on, even empty.
# SOLID_QUEUE_IN_PUMA=true
