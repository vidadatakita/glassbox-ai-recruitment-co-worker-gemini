<%# Offer letters (E24): upload a PDF; the candidate answers in the portal. %>
<div class="hris-form-card">
  <div class="hris-form-card__header"><div class="hris-form-card__icon"><i class="fa fa-envelope-o"></i></div>
    <div><h3>Job offer</h3><p>Upload the offer letter (PDF) once the applicant has passed the last stage. The applicant opens it with the code from the email.</p></div></div>
  <div class="hris-form-card__body">
    <% if offers.any? %>
      <div class="table-responsive mb-3">
        <table class="table mb-0">
          <thead><tr><th>Version</th><th>Start date</th><th>Answer by</th><th>Answer</th><th>Follow-up</th></tr></thead>
          <tbody>
            <% offers.each do |offer| %>
              <tr>
                <td><%= offer.version %><%= " (latest)" if offer == offers.first %></td>
                <td><%= wib(offer.start_at) %></td>
                <td><%= l(offer.valid_until, format: :long) %></td>
                <td><%= { "accepted" => "Accepted", "declined" => "Declined" }.fetch(offer.response, "Not answered yet") %><% if offer.response_reason.present? %>: <%= offer.response_reason %><% end %></td>
                <td><%= offer.followed_up_at ? wib(offer.followed_up_at) : "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <% if current_user.role == "consultant" && !offers.any?(&:accepted?) %>
      <%= form_with url: staff_application_offers_path(application), method: :post, scope: :offer, multipart: true, data: { turbo: false, submit_guard: true } do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :pdf, "Offer letter (PDF)", class: "form-label" %>
            <%= f.file_field :pdf, accept: "application/pdf", class: "form-control", required: true %>
          </div>
          <div class="col-md-3">
            <%= f.label :start_at, "Start date (WIB)", class: "form-label" %>
            <%= f.datetime_local_field :start_at, class: "form-control", required: true %>
          </div>
          <div class="col-md-3">
            <%= f.label :valid_until, "Answer by", class: "form-label" %>
            <%= f.date_field :valid_until, class: "form-control", required: true %>
          </div>
          <div class="col-12">
            <%= f.label :day_one_notes, "First-day preparation", class: "form-label" %>
            <%= f.text_area :day_one_notes, rows: 3, class: "form-control", required: true %>
            <span class="hris-field-hint">Shown to the applicant after they accept the offer.</span>
          </div>
        </div>
        <div class="mt-3"><%= label_button(offers.any? ? "Upload new version" : "Upload offer", "fa-upload") %></div>
      <% end %>
    <% end %>
  </div>
</div>
