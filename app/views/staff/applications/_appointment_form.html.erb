<% url = appointment ? staff_appointment_path(appointment) : staff_participation_appointments_path(participation) %>
<%= form_with url: url, method: appointment ? :patch : :post, scope: :appointment, data: { turbo: false, submit_guard: true } do |f| %>
  <div class="row g-3">
    <div class="col-md-3">
      <label class="form-label" for="starts_at_<%= participation.id %>">Start (WIB)</label>
      <input type="datetime-local" class="form-control" id="starts_at_<%= participation.id %>" name="appointment[starts_at]" value="<%= appointment&.starts_at&.in_time_zone&.strftime("%Y-%m-%dT%H:%M") %>" required>
    </div>
    <div class="col-md-3">
      <label class="form-label" for="ends_at_<%= participation.id %>">End (WIB)</label>
      <input type="datetime-local" class="form-control" id="ends_at_<%= participation.id %>" name="appointment[ends_at]" value="<%= appointment&.ends_at&.in_time_zone&.strftime("%Y-%m-%dT%H:%M") %>" required>
    </div>
    <div class="col-md-2">
      <label class="form-label" for="mode_<%= participation.id %>">Mode</label>
      <%= f.select :mode, Appointment::MODES.invert, { selected: appointment&.mode }, class: "form-select", id: "mode_#{participation.id}" %>
    </div>
    <div class="col-md-4">
      <label class="form-label" for="place_<%= participation.id %>">Place or video link</label>
      <%= f.text_field :place_or_link, value: appointment&.place_or_link, class: "form-control", id: "place_#{participation.id}", required: true %>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="bring_<%= participation.id %>">What to bring</label>
      <%= f.text_field :bring, value: appointment&.bring, class: "form-control", id: "bring_#{participation.id}" %>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="contact_<%= participation.id %>">Contact</label>
      <%= f.text_field :contact, value: appointment&.contact, class: "form-control", id: "contact_#{participation.id}", required: true %>
    </div>
  </div>
  <div class="mt-3"><%= label_button(appointment ? "Save appointment changes" : "Save appointment", "fa-calendar") %></div>
<% end %>
