<%# The stages of this application, one card per stage in process order (Vida, 17 Oct 2026: one
    section per process, never mixed). This partial only arranges; each stage is _stage_card. Scores
    are staff-only and entered on the scoring screens; a changed appointment asks the applicant to
    confirm again. %>
<% participations = application.participations.includes(:stage).sort_by { |p| Stage::CODES.index(p.stage.code) || 99 } %>
<% if participations.empty? %>
  <div class="hris-form-card"><div class="hris-form-card__body"><p class="text-muted mb-0">The applicant has not entered any stage yet.</p></div></div>
<% end %>
<% participations.each_with_index do |participation, i| %>
  <%= render "staff/applications/stage_card", participation: participation, number: i + 1 %>
<% end %>
