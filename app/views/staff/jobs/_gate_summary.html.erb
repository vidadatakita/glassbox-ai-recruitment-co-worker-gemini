<%# The gate result as parts of the whole: each share against all applicants in the gate. %>
<div class="gate-summary" aria-label="Gate result">
  <% [[:passed, "Passed the gate"], [:open, "Waiting for a decision"], [:not_passed, "Not passed"]].each do |result, label| %>
    <% n = gate.result_count(result) %>
    <div class="gate-summary__item gate-summary__item--<%= Gates::Result::TONES.fetch(result) %>">
      <span class="gate-summary__label"><%= label %></span>
      <span class="gate-summary__num"><%= n %></span>
      <span class="gate-summary__share"><%= gate.percent(n) %>% of <%= gate.total %></span>
      <span class="portal-funnel__track"><span class="portal-funnel__fill" style="width: <%= gate.percent(n) %>%"></span></span>
    </div>
  <% end %>
</div>
<% waiting = gate.result_count(:open) %>
<% if gate.total.zero? %>
  <p class="text-muted mb-3">No applicants in this gate yet.</p>
<% elsif waiting.positive? %>
  <%# One line (17 Oct 2026, "too much wording"): what is waiting and what it blocks. %>
  <p class="portal-insight mb-3"><i class="fa fa-exclamation-circle me-1" aria-hidden="true"></i><%= waiting %> <%= "applicant".pluralize(waiting) %> waiting for a decision; the gate closes when everyone is decided.</p>
<% end %>
