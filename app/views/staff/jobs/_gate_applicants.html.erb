<%# Per applicant: the two stage decisions and the gate result. Waiting first (someone must act),
    then passed, then not passed. %>
<p class="text-muted gate-table__note">Waiting first. "Passed" needs both stages.</p>
<div class="table-responsive">
  <table class="table table-hover align-middle mb-0 gate-table">
    <thead><tr><th>Applicant</th><th>CV screening</th><th>Technical test</th><th>Gate result</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
      <% if gate.rows.empty? %><tr><td colspan="5" class="text-muted">No applicants yet.</td></tr><% end %>
      <% gate.rows.each do |row| %>
        <% person = screening_person(row.s1, gate) %>
        <tr>
          <td class="gate-table__person"><%= person %></td>
          <td data-label="CV screening"><%= gate_decision_badge(row.s1_decision) %></td>
          <td data-label="Technical test"><%= row.s2 ? gate_decision_badge(row.s2_decision) : content_tag(:span, "Not in this stage", class: "portal-state portal-state--muted") %></td>
          <td data-label="Gate result"><%= gate_result_badge(row.result) %></td>
          <td class="hris-table-actions">
            <% if can_open_applications? %>
              <%= link_to staff_application_path(row.s1.job_application), class: "btn btn-sm btn-primary-light", title: "View details #{person}" do %>
                <i class="fa fa-plus" aria-hidden="true"></i><span class="visually-hidden">View details <%= person %></span>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
