<%# Feature 09 (D51): the release step and its pilot figures on the vacancy home. Counts only, no
    CV text, so every staff role may see it; the link to the texts is the reviewer's alone. %>
<% measure = AiReleases::PilotMeasure.new(job: board.job) %>
<div class="screening-release screening-note mb-3" id="pemeriksaan-ai">
  <% if Screening::Config.review_before_ai? %>
    <p class="mb-1"><strong>Review before AI.</strong> <%= board.awaiting_release.size %> CVs wait for the reviewer; none reaches Gemini without that check.</p>
  <% else %>
    <%# AI_SCREENING_REVIEW=auto: every clean CV is screened as it arrives; people decide on the result. %>
    <p class="mb-1"><strong>Automatic screening.</strong> Each CV is redacted, then scored; <%= board.awaiting_release.size %> held for the reviewer because personal data remained.</p>
  <% end %>
  <details class="tech-details"><summary>Technical details</summary>
  <p class="text-muted small mb-0">Pilot measure: <%= measure.cvs %> CVs checked · <%= measure.released %> sent · <%= measure.residual %> caught · <%= measure.cut %> cut · <%= measure.declined %> not sent · AI flagged <%= measure.model_flagged %> of <%= measure.answered %></p>
  </details>
</div>
