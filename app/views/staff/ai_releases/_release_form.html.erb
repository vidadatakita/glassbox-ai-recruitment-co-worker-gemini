<%# "Send to Gemini". The tick is checked on the server (AiReleases::Release); the button is never
    disabled. The hidden digest ties the release to the version on screen. %>
<div class="card custom-card">
  <div class="card-header"><div class="card-title">Send to Gemini</div></div>
  <div class="card-body">
    <%= form_with url: staff_ai_release_send_path(release), method: :post, data: { turbo: false, submit_guard: true } do %>
      <input type="hidden" name="payload_sha256" value="<%= release.payload_sha256 %>">
      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="confirmed" value="1" id="confirmed_<%= release.id %>" required>
        <label class="form-check-label" for="confirmed_<%= release.id %>">I have checked this text and no personal data is visible</label>
      </div>
      <p class="small text-muted">Your name and the time are recorded. The AI receives exactly the same text.</p>
      <%= label_button "Send to Gemini", "fa-paper-plane", purpose: :approve %>
    <% end %>
  </div>
</div>
