<%# AI Builder Cup standard item 1: before / after. "With AiCoHire" is measured from this
    organization's records (Impact); "Before" is the client's own figure from Settings,
    shown as "not entered" until someone enters it, never invented. This view only orchestrates;
    each section is its own partial and the figures are built once in ImpactHelper#impact_rows. %>
<% content_for :title, "Impact summary" %>
<% rows = impact_rows(@impact, @baseline) %>
<div class="portal-page loan-index-page layout-decoration-page impact-page">
  <%= render "staff/shared/page_header", eyebrow: "Impact summary · AiCoHire by GlassBox", title: "Before and after AiCoHire",
             subtitle: "Measured from #{@impact.applications} applications in your vacancies.#{" Includes sample (synthetic) data from the demo vacancy." if @impact.includes_demo?}" %>
  <section class="content">
    <%= render "staff/impacts/baseline_note", baseline: @baseline %>
    <%= render "staff/impacts/headline", rows: rows %>
    <%= render "staff/impacts/matrix", rows: rows, by_job: @by_job, baseline: @baseline %>
    <%= render "staff/impacts/safeguards" %>
  </section>
</div>
