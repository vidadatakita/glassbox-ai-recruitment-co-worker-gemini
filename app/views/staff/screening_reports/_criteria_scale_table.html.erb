<%# D53: per criterion the 1-5 shown to the client (ScreeningReport::CriterionScale) beside the AI's
    original judgement, which is what the score and the decisions use. Quotes verbatim, an unfound
    quote marked, never hidden (§4.1 step 6). %>
<div class="table-responsive">
  <table class="table table-sm align-middle screening-criteria report-criteria">
    <thead><tr><th>Requirement</th><th>Tier</th><th>Score (1–5)</th><th>AI advice</th><th>CV quote</th></tr></thead>
    <tbody>
      <% result.criteria.each do |c| %>
        <tr>
          <td><%= c["text"] %></td>
          <td><%= tier_label(c["tier"]) %><%= " · weight #{c["weight"]}" if c["tier"] == "sebaiknya" %></td>
          <td class="report-criteria__score"><strong class="report-score"><%= ScreeningReport::CriterionScale.of(c["tier"], c["judgement"]) %></strong></td>
          <td><%= judgement_label(c["tier"], c["judgement"]) %></td>
          <td><%= render "staff/screening_reports/quote", quote: c["quote"], verified: c["verified"], row: row %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="report-band-rule"><%= ScreeningReport::CriterionScale::RULE %></p>
