<%# SPEC §2.2: Education and Latest experience, two boxes, each with the CV quote behind it.
    When the AI's text and the CV quote are the same words (they often are: the AI copies the CV
    line), the page printed the same sentence twice. Then only the quote is shown, captioned "CV
    quote", so the quote check and its "unverified" mark stay visible. The comparison ignores only
    surrounding space and a final full stop; any other difference shows both, as before. %>
<% facts = [["Education", "fa-graduation-cap", result&.education], ["Latest experience", "fa-briefcase", result&.recent_experience]] %>
<% same_words = ->(text, quote) {
     norm = ->(s) { s.to_s.squish.delete_suffix(".") }
     passages = Screening::QuoteCheck.passages(quote)
     passages.size == 1 && norm.(passages.first) == norm.(text) } %>
<div class="report-pair">
  <% facts.each do |title, icon, fact| %>
    <div class="hris-form-card">
      <div class="hris-form-card__header"><div class="hris-form-card__icon"><i class="fa <%= icon %>" aria-hidden="true"></i></div><div><h3><%= title %></h3></div></div>
      <div class="hris-form-card__body">
        <% if fact.is_a?(Hash) && fact["text"].present? %>
          <% if same_words.(fact["text"], fact["quote"]) %>
            <p class="report-quote-caption">CV quote</p>
          <% else %>
            <p class="mb-2"><%= report_ai(fact["text"], row) %></p>
          <% end %>
          <%= render "staff/screening_reports/quote", quote: fact["quote"], verified: fact["verified"], row: row %>
        <% else %>
          <p class="text-muted mb-0"><%= result.nil? ? "Not screened by the AI yet." : "Not in the AI result (a result from before the report prompt version, or the CV does not mention it)." %></p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
