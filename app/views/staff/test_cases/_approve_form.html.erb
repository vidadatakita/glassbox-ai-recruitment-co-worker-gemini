<%# The approval action for a draft version, its own partial so the editor's page shows it too
    (17 Oct 2026: with three roles the person who may edit the case may also approve it, the
    superadmin included; before, the editor and the approver were different roles). %>
<% if test_case.draft? && TestCases::Authority.may_approve?(current_user) %>
  <%= form_with url: staff_job_test_case_approve_path(job, test_case), method: :post, class: "test-case-approve hris-form-actions hris-form-actions--static",
                data: { turbo: false, submit_guard: true } do %>
    <%# Maker-checker (engine 07 F-02): the fingerprint of exactly what this page shows. %>
    <input type="hidden" name="content_digest" value="<%= test_case.content_digest %>">
    <p class="hris-form-actions__note mb-0"><i class="fa fa-info-circle" aria-hidden="true"></i> Check the case study file, the instructions and the rubric. Once approved, this version cannot be changed; any later change becomes a new version.</p>
    <div class="hris-form-actions__buttons"><%= label_button "Approve version #{test_case.version}", "fa-check", purpose: :approve %></div>
  <% end %>
<% end %>
