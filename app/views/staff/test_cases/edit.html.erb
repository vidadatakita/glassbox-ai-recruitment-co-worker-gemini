<%# Brief step 5 "Technical test" (D60 slice 2, plan §c). Orchestrates only: overview first (what is in
    force, what waits for whom), then the versions, then the editor (consultant) or the read-only
    version with the approval action (HR PIC). Each action is its own form; none is nested. %>
<% content_for :title, "Technical test · #{@job.title}" %>
<% editor = TestCases::Authority.may_edit?(current_user, @job) %>
<div class="portal-page loan-index-page layout-decoration-page job-brief-page test-case-page">
  <%= render "staff/shared/page_header", eyebrow: "Vacancy brief", title: @job.title,
             subtitle: "Step 5 of 5: Technical test. A case study per position, taken by the applicant after applying, scored by the reviewer with a rubric.",
             actions: label_link("Back", "fa-arrow-left", staff_job_brief_path(@job), purpose: :neutral, icon_end: true) %>
  <section class="content salary-schema-page">
    <%= render "staff/job_briefs/stepper", job: @job, step: "5", check: @check %>
    <%= render "staff/job_briefs/errors", errors: @errors %>
    <%= render "staff/test_cases/status", job: @job, current: @current, latest: @latest %>
    <%= render "staff/test_cases/versions", job: @job, versions: @versions, current: @current %>
    <% if editor %>
      <%= render "staff/job_briefs/ai_suggest", job: @job, step: "5", suggestion: @suggestion, allowed: true %>
      <%= render "staff/test_cases/form", job: @job, form: @form %>
    <% else %>
      <%= render "staff/test_cases/version_detail", job: @job, test_case: @latest, current: @current %>
    <% end %>
    <%# Step 5 is the brief's last step for this package, so the brief is completed here (it needs an
        HR-approved test version; Briefs::BriefCheck says what else is missing). Its own form. %>
    <% if !@job.brief_complete? && current_user.role.in?(Staff::JobBriefsController::EDITORS.map(&:to_s)) %>
      <%# Same look as the action bar, but not sticky: the test form above has its own sticky "Save",
          and two sticky bars stack and hide it. %>
      <div class="hris-form-actions hris-form-actions--static">
        <div class="hris-form-actions__note"><i class="fa fa-flag-checkered" aria-hidden="true"></i>
          <span><strong>Last step.</strong> Complete the brief once HR has approved a test version; if anything is still missing, the brief page shows it.</span></div>
        <div class="hris-form-actions__buttons">
          <%= button_to staff_job_brief_complete_path(@job), method: :post, class: "btn btn-success label-btn",
                        form: { data: { turbo: false, submit_guard: true } } do %>
            <i class="fa fa-check label-btn-icon me-2" aria-hidden="true"></i><span>Complete brief</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>
