<% plan = job.stage_plan || {} %>
<% stages = job.stages.index_by(&:code) %>
<%= render layout: "staff/job_briefs/card", locals: { icon: "fa-cubes", tone: "info", title: "Package & stages",
           text: job.package ? "#{package_label(job.package)}; recommended for #{job.golongan_label}: #{Briefs::PackageAdvisor.recommended(job.golongan).map { |p| package_label(p) }.join(' or ')}." : "No package chosen yet. The package is chosen in step 4." } do %>
  <% if job.package_override_reason.present? %>
    <p class="job-brief-insight">Package outside the recommendation. Reason: <%= job.package_override_reason %></p>
  <% end %>
  <% if job.package %>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>Stage</th><th class="text-end">Weight</th><th class="text-end">Pass score</th><th>Status</th></tr></thead>
        <tbody>
          <% Briefs::StagePlan.codes(job.package).each do |code| %>
            <% stage = stages[code] %>
            <tr>
              <td><%= stage_label(code) %></td>
              <% if code == "RC" %>
                <td class="text-end" colspan="2">No score</td>
              <% else %>
                <td class="text-end"><%= stage ? stage.weight : (plan.dig(code, "weight") || "-") %>%</td>
                <td class="text-end"><%= threshold_text(stage ? stage.threshold : plan.dig(code, "threshold")) %></td>
              <% end %>
              <td><%= stage ? { "draft" => "Not yet open", "open" => "Open (locked)", "closed" => "Closed" }[stage.status] : "Created when the brief is completed" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
