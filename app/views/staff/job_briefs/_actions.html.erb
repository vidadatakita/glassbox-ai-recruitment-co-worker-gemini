<%# Sticky action bar (layout contract §5.0 point 5). No button is ever disabled (house hard rule);
    the guard on the form blocks a second submit instead. Step 4 has two named buttons: the server
    dispatches on `finish`, not on the label. %>
<div class="hris-form-actions">
  <div class="hris-form-actions__note"><i class="fa fa-info-circle" aria-hidden="true"></i>
    <span><%= step == "4" && !local_assigns[:test_next] ? "Save stores a draft. Complete the brief once every part is filled in; every change is recorded with a name and time." : "Save & next stores a draft and opens the next step. Every change is recorded with a name and time." %></span></div>
  <div class="hris-form-actions__buttons">
    <%= label_link "Cancel", "fa-times", job.persisted? ? staff_job_brief_path(job) : staff_jobs_path, purpose: :neutral, icon_end: true %>
    <% if step == "4" && local_assigns[:test_next] %>
      <%# Step 5 (technical test) follows; the brief is completed there. %>
      <%= label_button "Save", "fa-save", purpose: :neutral %>
      <%= label_button "Save & next", "fa-save", name: "lanjut", value: "1", class: "hris-submit-button" %>
    <% elsif step == "4" %>
      <%= label_button "Save", "fa-save", purpose: (job.brief_complete? ? :submit : :neutral) %>
      <% unless job.brief_complete? %>
        <%= label_button "Save & complete brief", "fa-check", name: "finish", value: "1", purpose: :approve, class: "hris-submit-button" %>
      <% end %>
    <% else %>
      <%# Steps 1-3 save and open the next step, so the label says both. The controller dispatches on
          the named buttons (`finish`, `lanjut`), never on the commit value, so the value follows the label. %>
      <%= label_button "Save & next", "fa-save", class: "hris-submit-button" %>
    <% end %>
  </div>
</div>
