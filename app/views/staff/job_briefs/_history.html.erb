<%# D49 (5) "every change recorded": the latest changes, who, in which role, which step, which fields. %>
<% changes = job.brief_changes.includes(:actor).order(created_at: :desc).limit(20).to_a %>
<div class="card custom-card">
  <div class="card-header"><div class="card-title">Brief change history <span class="text-muted fw-normal fs-13">· last <%= changes.size %> changes, newest first</span></div></div>
  <div class="card-body table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Time</th><th>By</th><th>Step</th><th>What changed</th></tr></thead>
      <tbody>
        <% if changes.empty? %><tr><td colspan="4" class="text-muted">No changes yet. Every brief save is recorded here with a name and time.</td></tr><% end %>
        <% changes.each do |change| %>
          <tr><td><%= wib(change.created_at) %></td>
            <td><%= change.actor.name %> <small class="text-muted">(<%= User::ROLE_LABELS[change.actor_role] %>)</small></td>
            <td><%= JobBriefChange::STEP_LABELS[change.step] %></td>
            <td><%= change.changes_made.keys.map { |k| t("brief_fields.#{k}", default: k.humanize) }.join(", ") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
