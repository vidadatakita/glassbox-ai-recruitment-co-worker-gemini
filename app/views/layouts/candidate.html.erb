<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "AiCoHire by GlassBox"].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "candidate" %>
    <%= stylesheet_link_tag "brand" %>
    <%= stylesheet_link_tag "layout_apply" %>
    <%# Only the three scripts candidate pages use. Turbo and Stimulus (about 155 KB of the 197 KB
        this page used to load) are left out: every candidate form runs with Turbo off and no
        Stimulus controller is used here. A candidate
        feature that needs Turbo must add it back on purpose. %>
    <%# test_countdown: the technical-test clock (D60), display only, inert without [data-due-at]. %>
    <%= javascript_include_tag "submit_guard", "file_pick", "consent_disclosure", "test_countdown", "apply_autosave", type: "module" %>
  </head>
  <body>
    <main class="cand">
      <%= render "layouts/brand", variant: :candidate %>
      <%= yield :top %>
      <%# Shell: the page card, plus an optional side column (trust block, what to prepare) that
          sits beside the card on desktop and above it on a phone. %>
      <% shell = ["cand-shell", (content_for?(:aside) ? "cand-shell--aside" : nil), (content_for?(:top) ? nil : "cand-shell--plain")].compact.join(" ") %>
      <div class="<%= shell %>">
        <% if content_for?(:aside) %><aside class="cand-aside" aria-label="Vacancy information"><%= yield :aside %></aside><% end %>
        <div class="cand-body">
          <% flash.each do |type, message| %>
            <p class="flash <%= type == "notice" ? "notice" : "alert" %>" role="status"><%= message %></p>
          <% end %>
          <%= yield %>
        </div>
        <%# Helpful but secondary: under the card on a phone, in the side column on desktop. %>
        <% if content_for?(:aside_after) %><aside class="cand-aside cand-aside--after" aria-label="What to prepare"><%= yield :aside_after %></aside><% end %>
      </div>
      <%# Two spans so a narrow screen breaks the line at the dot, not inside the slogan. %>
      <footer class="cand-foot"><span>GlassBox Team</span> · <span>Evidence you can see. Decisions someone owns.</span></footer>
    </main>
  </body>
</html>
