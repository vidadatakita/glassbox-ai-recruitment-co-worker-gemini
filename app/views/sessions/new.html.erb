<% content_for :title, "Sign in · AiCoHire" %>
<% content_for :auth_hero do %><%= render "sessions/hero" %><% end %>
<div class="auth-panel__eyebrow">Welcome back</div>
<h2 class="auth-panel__title">Sign in to AiCoHire</h2>
<p class="auth-panel__lead">For the HR team. Applicants need no account; they use the status link from their email.</p>
<% if flash[:alert] %><div class="alert alert-warning" role="alert"><%= flash[:alert] %></div><% end %>
<% if flash[:notice] %><div class="alert alert-success" role="status"><%= flash[:notice] %></div><% end %>
<%= form_with url: session_path, data: { turbo: false, submit_guard: true } do |form| %>
  <div class="row gy-3">
    <div class="col-12">
      <%= form.label :email_address, "Email", class: "form-label text-default" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], placeholder: "name@company.co.id", class: "form-control form-control-lg" %>
    </div>
    <div class="col-12">
      <%= form.label :password, "Password", class: "form-label text-default" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-control form-control-lg" %>
    </div>
  </div>
  <div class="d-grid mt-4">
    <%# The commit value is not read by SessionsController; it follows the label. %>
    <button type="submit" class="btn btn-lg btn-primary" name="commit" value="Sign in">Sign in</button>
  </div>
<% end %>
<%# D52 (1): shown only while Google login is configured. It is its OWN form (button_to) and sits
    AFTER the password form, never inside it (hard rule: no form inside a form). POST with the
    authenticity token; a GET link would reopen login CSRF. %>
<% if GoogleIntegration::Config.login_configured? %>
  <div class="text-center my-3 authentication-barrier"><span>or</span></div>
  <%= button_to google_login_path, method: :post, class: "btn btn-lg btn-light border w-100 d-flex align-items-center justify-content-center gap-2", form: { data: { turbo: false, submit_guard: true } } do %>
    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
    <span>Sign in with Google</span>
  <% end %>
<% end %>
<%# antislop audit 001 #4(b): the generator's password-reset mail sender is not configured, so the
    reset flow is not linked until MAIL_* exists (Plan 4). The reset code stays. %>
<p class="text-muted text-center fs-12 mt-4 mb-0">Forgot your password? Contact the admin to reset it.</p>
